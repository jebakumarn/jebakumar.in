---
// Dark/light switch. Wired up by src/scripts/theme.ts via the data-theme-toggle
// attribute. Sun glyph = light, moon glyph = dark (via CSS ::before).
---
<label class="theme-switch" title="Toggle light / dark theme" aria-label="Toggle light or dark theme">
  <input type="checkbox" data-theme-toggle />
  <span class="slider"></span>
</label>
