---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { profile } from '../data/profile';

const contactCards = [
  { icon: 'fas fa-envelope', label: 'Email', value: 'jebakumar@gmail.com', href: 'mailto:jebakumar@gmail.com' },
  { icon: 'fas fa-mobile-alt', label: 'Phone', value: '+91-9952235964', href: 'tel:+91-9952235964' },
  { icon: 'fab fa-whatsapp', label: 'WhatsApp', value: '+91 99522 35964', href: 'https://wa.me/+919952235964' },
  { icon: 'fab fa-linkedin', label: 'LinkedIn', value: 'in/jebakumarg', href: 'https://www.linkedin.com/in/jebakumarg' },
];
---
<BaseLayout title="Jebakumar — Contact">
  <section class="section">
    <div class="container">
      <p class="section-label">get_in_touch</p>
      <h1 class="section-title mono">./contact.sh<span class="cursor" aria-hidden="true"></span></h1>

      <div class="grid grid-2 contact-grid">
        <!-- Contact form -->
        <TerminalWindow path="~/contact/message.txt">
          <p class="prompt mono">./send_message.sh</p>
          <div id="contact-success" class="alert alert-success hidden">
            ✔ Message queued. Thanks — I'll get back to you soon.
          </div>
          <form id="contact-form" novalidate>
            <div class="field">
              <label for="name">name</label>
              <input class="input" type="text" id="name" name="name" placeholder="your name" required />
            </div>
            <div class="field">
              <label for="email">email</label>
              <input class="input" type="email" id="email" name="email" placeholder="you@example.com" required />
            </div>
            <div class="field">
              <label for="subject">subject</label>
              <input class="input" type="text" id="subject" name="subject" placeholder="subject" required />
            </div>
            <div class="field">
              <label for="message">message</label>
              <textarea class="textarea" id="message" name="message" placeholder="your message..." required></textarea>
            </div>
            <button class="btn" type="submit">[ send ]</button>
          </form>
        </TerminalWindow>

        <!-- AI chatbot -->
        <TerminalWindow path="~/contact/assistant — llm">
          <p class="prompt mono">./ask_assistant.sh</p>
          <p class="dim chat-hint mono">
            Ask about Jeba's work, or general questions. Off-topic / non-professional
            questions are declined.
          </p>
          <div id="chat-messages" class="chatbot-messages">
            <div class="message bot-message">
              <div class="message-content">
                <p>Hi! I'm Jeba's assistant. Ask me anything about his experience, projects, or how to reach him.</p>
              </div>
            </div>
          </div>
          <form id="chat-form" class="chat-form" autocomplete="off">
            <input class="input" type="text" id="chat-input" placeholder="type a message..." aria-label="Chat message" />
            <button class="btn" type="submit">[ ↵ ]</button>
          </form>
        </TerminalWindow>
      </div>

      <!-- Contact cards -->
      <div class="grid grid-3 cards-row">
        {contactCards.map((c) => (
          <a class="contact-card" href={c.href} target="_blank" rel="noopener">
            <i class={c.icon}></i>
            <div>
              <span class="dim mono contact-card-label">{c.label}</span>
              <span class="mono contact-card-value">{c.value}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    align-items: start;
    margin-bottom: 1.5rem;
  }
  .chat-hint {
    font-size: 0.78rem;
    margin: 0.25rem 0 1rem;
  }
  .chatbot-messages {
    height: 320px;
    overflow-y: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg);
    padding: 0.9rem;
    margin-bottom: 0.9rem;
  }
  .chat-form {
    display: flex;
    gap: 0.5rem;
  }
  .chat-form .input {
    flex: 1;
  }

  /* Chat bubbles (was injected by chatbot.js on the legacy site). */
  .message {
    margin-bottom: 12px;
    display: flex;
  }
  .user-message {
    justify-content: flex-end;
  }
  .message-content {
    max-width: 80%;
    padding: 8px 13px;
    border-radius: 12px;
    font-size: 0.9rem;
  }
  .bot-message .message-content {
    background: var(--bg-elev-2);
    color: var(--fg);
    border: 1px solid var(--border);
  }
  .user-message .message-content {
    background: var(--amber);
    color: var(--bg);
  }
  .message-content p {
    margin: 0;
    white-space: pre-wrap;
  }
  .message-content.typing {
    display: inline-flex;
    gap: 4px;
    align-items: center;
  }
  .message-content.typing span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fg);
    opacity: 0.5;
    animation: chat-blink 1.2s infinite both;
  }
  .message-content.typing span:nth-child(2) {
    animation-delay: 0.2s;
  }
  .message-content.typing span:nth-child(3) {
    animation-delay: 0.4s;
  }
  @keyframes chat-blink {
    0%,
    80%,
    100% {
      opacity: 0.2;
    }
    40% {
      opacity: 0.9;
    }
  }

  .cards-row {
    margin-top: 0.5rem;
  }
  .contact-card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 1rem 1.1rem;
    color: var(--fg);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .contact-card:hover {
    border-color: var(--amber);
    transform: translateY(-3px);
    text-decoration: none;
  }
  .contact-card i {
    font-size: 1.4rem;
    color: var(--amber);
    width: 1.5rem;
    text-align: center;
  }
  .contact-card-label {
    display: block;
    font-size: 0.72rem;
  }
  .contact-card-value {
    display: block;
    font-size: 0.9rem;
    color: var(--fg-strong);
  }
</style>

<script>
  import '../scripts/contactForm.ts';
  import '../scripts/chatbot.ts';
</script>
